{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sspanel.dev/contracts/external-module-manifest/1.0/schema.json",
  "title": "SS-panel external module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleId",
    "platform",
    "contractVersions",
    "capabilities",
    "workflowTypes",
    "supportsPolling",
    "supportsCallbacks"
  ],
  "properties": {
    "moduleId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["instagram"] },
    "contractVersions": {
      "type": "array",
      "items": { "type": "string", "enum": ["1.0", "1.1"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputSchemas": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/inputSchema" }
    },
    "workflowTypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supportsPolling": { "type": "boolean" },
    "supportsCallbacks": { "type": "boolean" }
  },
  "$defs": {
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/inputField" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "array", "object"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "enum": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "array", "object"] }
          }
        },
        "default": {}
      }
    }
  }
}
